# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and must never be committed.
#
# The NEXT_PUBLIC_ prefix means "ship this to the browser". Anything without it
# stays on the server. Never add the prefix to a key, secret, or token.

# --- Public: safe in the browser. RLS is what protects the data. ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where Hilo lives. Goes into the links inside emails and into the booking link
# you hand to families, so it has to be the real address in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server only. These bypass or unlock things. Never prefix them. ---

# Bypasses Row Level Security entirely. Used in exactly five files, listed in
# the allowlist in eslint.config.mjs — adding a sixth means editing that list.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for clinical report generation.
ANTHROPIC_API_KEY=

# Transactional email.
#
# MAIL_FROM decides more than the name on the message. With Resend's shared
# `onboarding@resend.dev` sender, Resend only delivers to the address that owns
# the Resend account and rejects every other recipient — at the API, before an
# email record exists, so the dashboard shows "No sent emails yet" rather than a
# bounce. In production that reads as "email is broken and leaves no trace".
#
# It is fine locally. In production MAIL_FROM must use a domain verified under
# Resend → Domains, or no practitioner ever receives a booking notice.
RESEND_API_KEY=
MAIL_FROM="Hilo <onboarding@resend.dev>"

# Where "me falta este formato de informe" is sent. Optional, and the only
# optional variable in this file: without it the request is still saved and
# readable, it just is not announced. See the note in src/lib/env.ts.
OWNER_EMAIL=

# Set automatically by Vercel for cron jobs. Set it locally to any string.
CRON_SECRET=

# Shared secret used to verify Mercado Pago webhook signatures.
MP_WEBHOOK_SECRET=

# Google Calendar. Se piden en Google Cloud Console → APIs y servicios →
# Credenciales → ID de cliente de OAuth.
#
# El ID es público por diseño: viaja en la URL de autorización, a la vista de
# cualquiera. El secret no, y no tiene por qué salir nunca de Vercel.
#
# En el mismo lugar hay que cargar las URIs de redireccionamiento autorizadas, y
# tienen que coincidir carácter por carácter con las que arma la aplicación:
#
#   https://<tu-dominio>/api/google/callback
#   http://localhost:3000/api/google/callback
#
# Van en "URIs de redireccionamiento autorizados", NO en "Orígenes autorizados de
# JavaScript" — esa segunda caja rechaza cualquier cosa que tenga una ruta, y el
# error que devuelve no dice que la caja sea la equivocada.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
