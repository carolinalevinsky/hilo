# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and must never be committed.
#
# The NEXT_PUBLIC_ prefix means "ship this to the browser". Anything without it
# stays on the server. Never add the prefix to a key, secret, or token.

# --- Public: safe in the browser. RLS is what protects the data. ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only. These bypass or unlock things. Never prefix them. ---

# Bypasses Row Level Security entirely. Used in exactly four files.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for clinical report generation.
ANTHROPIC_API_KEY=

# Transactional email.
RESEND_API_KEY=
MAIL_FROM="Hilo <onboarding@resend.dev>"

# Set automatically by Vercel for cron jobs. Set it locally to any string.
CRON_SECRET=

# Shared secret used to verify Mercado Pago webhook signatures.
MP_WEBHOOK_SECRET=
