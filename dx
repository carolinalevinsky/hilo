#!/usr/bin/env bash
#
# Corre cualquier comando del proyecto dentro del contenedor de Node.
#
#   ./dx npm run dev          servidor local  → http://localhost:3000
#   ./dx npm run db:start     levanta Postgres
#   ./dx npm run typecheck    tipos
#   ./dx bash                 una shell adentro, para curiosear
#
# Existe porque esta Mac no tiene Node instalado. Es un andamio, no una
# decisión de arquitectura: el día que instales Node en el host, los mismos
# comandos funcionan sin el `./dx` adelante y esto se puede borrar entero.
#
# Dos detalles que hacen que funcione, y que son la parte no obvia:
#
#   El repo se monta en la MISMA ruta que tiene en tu Mac. No es capricho: el
#   CLI de Supabase levanta la base creando contenedores hermanos en el Docker
#   del host, y les pasa rutas de archivos. Si adentro el repo viviera en /app,
#   esas rutas no existirían del lado del host y los contenedores no arrancarían.
#
#   El socket de Docker se monta para que ese mismo CLI pueda crear los
#   contenedores. El contenedor no corre un Docker propio — le habla al tuyo.
#
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE="hilo-dev:latest"

# Los directorios de build, fuera del alcance de iCloud.
#
# El repo vive adentro de ~/Documents, que iCloud sincroniza. iCloud no entiende
# un directorio que cambia miles de veces por minuto: cuando dos escrituras se le
# cruzan no elige, deja las dos, y la segunda queda al lado como "archivo 2.ext".
#
# Eso rompe el build de verdad, no es ruido cosmético. `.next/types/**/*.ts` está
# incluido en el tsconfig, así que un `cache-life.d 2.ts` es un archivo de tipos
# que tsc abre y no entiende; y un `BUILD_ID 2` al lado del `BUILD_ID` deja al
# servidor sin saber cuál es el build. Se pierde una tarde buscándolo en el
# código, porque el código está bien.
#
# La marca hay que ponerla ANTES de que algo escriba adentro —por eso los
# directorios se crean acá vacíos— y en cada corrida, porque un `rm -rf .next` se
# lleva puesta la marca junto con el directorio.
#
# `#P` no es un comentario: es parte del nombre del atributo, y significa que no
# se copia si copiás el directorio a otro lado.
if command -v xattr >/dev/null 2>&1; then
  for dir in .next .next-e2e node_modules test-results playwright-report; do
    mkdir -p "$REPO/$dir"
    xattr -w 'com.apple.fileprovider.ignore#P' 1 "$REPO/$dir" 2>/dev/null || true
  done

  # Y las copias que ya quedaron de antes, que la marca no borra.
  #
  # Sólo adentro de estos directorios, y `node_modules` no está: son todos
  # descartables, así que acá un falso positivo no cuesta nada, mientras que el
  # mismo barrido sobre el repo entero podría llevarse un "Informe 2.pdf" tuyo
  # que se llama así porque vos lo llamaste así.
  leftovers=$(find "$REPO/.next" "$REPO/.next-e2e" "$REPO/test-results" \
    "$REPO/playwright-report" \
    \( -name '* [0-9]' -o -name '* [0-9].*' \) -print 2>/dev/null || true)
  if [ -n "$leftovers" ]; then
    echo "iCloud dejó $(printf '%s\n' "$leftovers" | wc -l | tr -d ' ') copias de conflicto en los directorios de build. Las borro." >&2
    printf '%s\n' "$leftovers" | while IFS= read -r stray; do rm -rf "$stray"; done
  fi
fi

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "Falta la imagen $IMAGE. La construyo..." >&2
  docker build -f "$REPO/docker/Dockerfile.dev" -t "$IMAGE" "$REPO/docker"
fi

args=(
  --rm
  --volume "$REPO:$REPO"
  --volume /var/run/docker.sock:/var/run/docker.sock
  # El navegador de Playwright, en un volumen con nombre.
  #
  # No va dentro del repo aunque sería lo obvio: el bind mount de macOS no le
  # da a Playwright el bloqueo de directorio que usa al instalar, y la descarga
  # muere con "Unable to update lock within the stale threshold". Y no va en la
  # imagen porque entonces subir @playwright/test obligaría a reconstruirla.
  # Un volumen sobrevive al --rm, es rápido, y se borra con
  # `docker volume rm hilo-playwright` si algo queda raro.
  --volume hilo-playwright:/root/.cache/ms-playwright
  --workdir "$REPO"
  --add-host host.docker.internal:host-gateway
  --env HOSTNAME=0.0.0.0
)

# Credenciales de Supabase, para hablarle a un proyecto de verdad.
#
# El contenedor es `--rm`, así que `supabase login` no sirve: el token se guarda
# en el home de adentro y se pierde al salir. Estas dos variables son la forma
# que tiene el CLI de recibirlo sin sesión guardada, y son las únicas que hacen
# falta para `link` y `db push`.
#
# Se pasan por NOMBRE, sin `=valor`: Docker lo toma de tu entorno y el valor
# nunca aparece en la línea de comandos, así que no queda en el historial de la
# shell ni en un `ps` que cualquiera puede leer. Corré así:
#
#   read -rs SUPABASE_ACCESS_TOKEN && export SUPABASE_ACCESS_TOKEN
#   ./dx npx supabase link --project-ref <ref>
#
# `read -rs` no muestra lo que escribís y no lo guarda en el historial.
#
# Las PG* son para `db:seed:remote`, que habla con psql directamente. Van por
# separado y no como una cadena `postgresql://…` a propósito: una cadena mete la
# contraseña adentro de una URL, y ahí una contraseña con `@`, `/` o `#` la parte
# al medio salvo que la codifiques a mano. psql lee estas variables sin
# interpretar nada, así que cualquier contraseña entra tal cual.
for secret in \
  SUPABASE_ACCESS_TOKEN \
  SUPABASE_DB_PASSWORD \
  PGHOST PGPORT PGUSER PGDATABASE PGPASSWORD
do
  [ -n "${!secret:-}" ] && args+=(--env "$secret")
done

# Una TTY sólo si la hay — así `./dx` también sirve desde un script o CI.
[ -t 0 ] && args+=(--interactive --tty)

# Publicar el puerto sólo si está libre. Si ya hay un dev server corriendo,
# publicarlo de nuevo sería un error; pero un `./dx npm run typecheck` en otra
# terminal no tiene por qué fallar por eso.
#
# PORT existe para cuando hay dos copias del repo abiertas a la vez — un
# worktree al lado del checkout principal. Sin esto la segunda arranca sin
# ningún puerto publicado y el navegador termina mirando la primera, que es un
# rato perdido buscando por qué "no se aplican los cambios":
#
#   PORT=3001 ./dx npm run dev
#
# Next lee PORT solo, así que alcanza con pasárselo al contenedor.
PORT="${PORT:-3000}"
args+=(--env "PORT=$PORT")

if ! lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
  args+=(--publish "$PORT:$PORT")
fi

exec docker run "${args[@]}" "$IMAGE" "$@"
